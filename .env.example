# Copy to .env.local for local testing; on Vercel add these under Project Settings > Environment Variables.

# Admin password for /admin (HTTP Basic Auth, any username).
ADMIN_PASSWORD=

# Supabase (database + file storage). Without them, data is saved to ./data on this machine.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Vendor fees: Stripe secret key (sk_test_... while testing, sk_live_... when live)
# and the signing secret (whsec_...) of the webhook pointing to <SITE_URL>/api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vendor emails (invites, reminders, decline notes, receipts) through Resend, sent from info@harlemnightmarket.com.
RESEND_API_KEY=
# Optional: override the sender, e.g. "Harlem Night Market <info@harlemnightmarket.com>".
EMAIL_FROM=

# Public address of the site, used in payment links. No trailing slash.
SITE_URL=https://www.harlemnightmarket.com

# Any long random string; lets Vercel's daily cron job send payment reminders.
CRON_SECRET=
